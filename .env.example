# Copy to .env and fill in. Values below are placeholders only.
# The .env file is gitignored. Never commit real keys.
# The package does not load .env files by itself: export the variables in your shell
# (or load the file with your process manager) before running a command.
# In PowerShell, set each one with $env:NAME = "value".

# --- Model selection -------------------------------------------------------
# mock (default, deterministic, no network) | openai_compatible | anthropic
LLM_PROVIDER=mock
# Only read from the environment. Leave empty while LLM_PROVIDER=mock.
LLM_API_KEY=
# Optional. Defaults: https://api.openai.com/v1 (openai_compatible), https://api.anthropic.com (anthropic).
LLM_BASE_URL=
LLM_MODEL=change-me
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=2048
# A number, or "none" to leave the parameter out of the request.
LLM_TEMPERATURE=0.2

# --- Agent runtime ---------------------------------------------------------
AGENT_MAX_ROUNDS=8
AGENT_MAX_STEPS=8
AGENT_WALL_CLOCK_SECONDS=60
# Time to live of the per-source result cache used by the demo and SQL Server backends.
AGENT_CACHE_TTL_SECONDS=45
# redact (default) | block
AGENT_EGRESS_POLICY=redact
# Optional path to a JSON file that overrides BusinessConfig defaults.
AGENT_BUSINESS_CONFIG=
# Optional JSON-lines file for safe per-call telemetry (no arguments, no data).
AGENT_TELEMETRY_PATH=
# Optional. Also send the same safe events to Langfuse. Needs the langfuse extra
# (pip install ".[langfuse]") and both keys below. The keys are only read from the environment.
AGENT_TELEMETRY_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional. Leave empty for Langfuse Cloud, or point it at a self-hosted server.
LANGFUSE_BASE_URL=
AGENT_CHAT_ENABLED=true

# --- SQL Server (only for the optional pyodbc connection helper) ------------
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_HOST=localhost
DB_NAME=change-me
# Optional, one database per product line. They fall back to DB_NAME.
DB_NAME_AUTO=
DB_NAME_CONSUMER=
DB_USER=change-me
DB_PASSWORD=change-me
